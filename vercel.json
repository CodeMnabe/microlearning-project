{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/webhook-events",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/public-abuse-cleanup",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/automations/inactivity",
      "schedule": "50 12 * * *"
    },
    {
      "path": "/api/cron/automations/materialize",
      "schedule": "55 12 * * *"
    },
    {
      "path": "/api/cron/process-scheduled-broadcasts",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/sync-read-receipts",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/read-chains",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/read-chain-delays",
      "schedule": "0 13 * * *"
    }
  ]
}
